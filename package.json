{
  "name": "ng-baseapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4202",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lib:build": "ng build @open-rlb/ng-app && npm run lib:build:schematics",
    "lib:build:schematics": "node scripts/build-schematics.mjs",
    "lib:test": "ng test @open-rlb/ng-app",
    "lib:test-ci": "ng test --no-watch --no-progress --browsers=ChromeHeadless @open-rlb/ng-app",
    "lib:test:ng-add": "node scripts/test-ng-add.cjs",
    "lib:lint": "ng lint @open-rlb/ng-app",
    "lib:pack": "npm run lib:build && npm pack ./dist/rlb/ng-app/ && node scripts/verify-pack.cjs",
    "postinstall": "ng g @open-rlb/ng-bootstrap:sync-skills || echo Skipped ng-bootstrap skill sync"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "author": {
    "name": "Giusseppe Riolo",
    "email": "riolo.giuseppe@gmail.com",
    "url": "https://github.com/riologiuseppe"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/riolabs/common/libraries/rlb-ng-baseapp"
  },
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@angular/service-worker": "^22.1.5",
    "@ngrx/effects": "^22.0.0",
    "@ngrx/operators": "^22.0.0",
    "@ngrx/signals": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@open-rlb/date-tz": "^2.1.8",
    "@open-rlb/ng-bootstrap": "^4.0.0",
    "@types/bootstrap": "^5.2.10",
    "angular-auth-oidc-client": "^19.0.1",
    "bootstrap-icons": "^1.13.1",
    "ngx-cookie-service": "^22.0.0",
    "ngx-cookie-service-ssr": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.1.7",
    "@angular-devkit/schematics": "^22.1.7",
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@ngrx/schematics": "^22.0.0",
    "@schematics/angular": "^22.1.7",
    "@types/bootstrap": "^5.2.10",
    "@types/jasmine": "~5.1.8",
    "@types/node": "~24.13.3",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
